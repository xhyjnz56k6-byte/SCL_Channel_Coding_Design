+int setIndexForZc(int zc) {
+    for (int row = 0; row < 8; ++row) {
+        for (int column = 0; column < 8; ++column) {
+            if (liftSizeTable[row][column] == zc) return row;
+        }
+    }
+    return -1;
+}
