+    for (const s4ldpc::IterationTrace& point : result.trace) {
+        output << config.id << ',' << config.actualLength << ',' << frameIndex << ',' << snr << ','
+               << decoder << ',' << alpha << ',' << policy << ',' << point.iteration << ','
+               << point.syndromeWeight << ',' << point.payloadErrorCount << ','
