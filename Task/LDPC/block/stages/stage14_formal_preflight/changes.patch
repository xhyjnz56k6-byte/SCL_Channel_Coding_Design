+           << snr << ',' << aggregate.frames << ',' << aggregate.bitErrors << ','
+           << aggregate.frameErrors << ',' << aggregate.syndromePasses << ','
+           << aggregate.correctValidFrames << ',' << aggregate.wrongValidFrames << ','
