+           << aggregate.complexity.alphaMultiplications << ',' << graph.edges.size() << ','
+           << payloadHashXor << ',' << codewordHashXor << ',' << llrHashXor << ','
+           << frameStart << ',' << frameEnd << '\n';
+}
