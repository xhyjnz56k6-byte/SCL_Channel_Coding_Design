+                row = {
+                    "caseId": f"LDPC_BG2_K300_N{n}", "actualLength": n, "snrDb": snr,
+                    "status": "PENDING", "frames": 0, "bpFrameErrors": 0,
+                    "nmsFrameErrors": 0, "nextFrameIndex": FRAME_START,
+                    "updateTime": "", "checkpointPath": "",
+                }
+            data.append(row)
+    return data
