+def collect_progress() -> list[dict]:
+    data = []
+    for n in LENGTHS:
+        for snr in SNRS:
+            key = point_key(n, snr)
+            path = RUNTIME / key / "progress.json"
+            if path.exists():
+                row = json.loads(path.read_text(encoding="utf-8"))
