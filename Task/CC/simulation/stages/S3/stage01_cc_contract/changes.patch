+    "maskOrder": "TIME_MAJOR_G1_THEN_G2",
+    "phaseFormula": "motherBitIndex % patternLength",
+    "tailPolicy": "CONTINUE_CURRENT_PATTERN_PHASE",
+    "continuousSlotPolicy": "CARRY_PATTERN_PHASE",
