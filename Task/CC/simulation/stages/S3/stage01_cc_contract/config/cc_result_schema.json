    "snrDb",
    "ebN0Db",
    "sigmaSquared",
    "sigma",
    "framesProcessed",
    "payloadBitsProcessed",
    "payloadBitErrors",
    "payloadErrorFrames",
    "BER",
    "FER",
    "payloadSuccessRate",
    "plotBER",
    "plotFER",
    "isZeroBitErrorPoint",
    "isZeroFrameErrorPoint",
    "avgEncodeTime_us",
