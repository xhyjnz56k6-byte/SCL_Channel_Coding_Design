    "framePoolHash",
    "noisePolicyVersion",
    "codeVersion",
    "functionalCommit",
    "encoderState",
    "puncturePhase",
    "decoderStateMetricState",
    "survivorBufferState"
  ],
  "checkpointResumeValidationFields": [
    "stageId",
    "experimentId",
    "caseId",
    "snrIndex",
    "snrDb",
    "configHash",
    "framePoolHash",
    "noisePolicyVersion",
    "codeVersion"
