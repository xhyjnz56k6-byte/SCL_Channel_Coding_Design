+    comparison = [r for r in comparison if r["channelType"] in selected_channels]
+    specs.append(("bch_s2_channel_comparison_fer.png", "多信道适应性综合比较",
+                  comparison_path, comparison, "snrDb", "FER", SNR_LABEL,
