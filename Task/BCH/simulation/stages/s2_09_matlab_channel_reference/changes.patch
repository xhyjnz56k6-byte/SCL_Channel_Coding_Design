+
+struct ImpairmentPointConfig {
+    std::string stage;
+    ImpairmentChannel channel = ImpairmentChannel::ResidualCfo;
+    BchCaseId caseId = BchCaseId::S200;
+    double sourcePayloadEbN0Db = 0.0;
+    std::uint64_t frameStart = 0U;
