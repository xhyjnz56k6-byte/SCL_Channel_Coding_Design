+                      "log", None))
+
+    cfo_snr_path = stages / "s2_05_residual_cfo/cfo_snr_aggregate_summary.csv"
+    cfo_snr = read(cfo_snr_path)
+    specs.append(("bch_s2_cfo_snr_fer.png", "残余频偏下的误帧率",
+                  cfo_snr_path, cfo_snr, "snrDb", "FER", SNR_LABEL,
