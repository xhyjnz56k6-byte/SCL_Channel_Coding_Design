diff --git a/Task/BCH/simulation/stages/S2/stage06_awgn_formal/cpp/stage06_awgn_formal_runner.cpp b/Task/BCH/simulation/stages/S2/stage06_awgn_formal/cpp/stage06_awgn_formal_runner.cpp
